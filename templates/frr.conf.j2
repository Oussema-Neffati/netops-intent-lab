{# Jinja2 template: one FRR config per router, rendered from intent/network.yml #}
{% set std = standards | default({}) %}
frr version {{ frr_version }}
frr defaults traditional
hostname {{ inventory_hostname }}
no ipv6 forwarding
!
{% for intf in r.interfaces %}
interface {{ intf.name }}
 description {{ intf.description }}
{% if intf.ip is defined %}
 ip address {{ intf.ip }}
{% endif %}
{% if intf.ospf_p2p | default(false) %}
 ip ospf network point-to-point
{% if std.ospf_md5_key is defined %}
 ip ospf authentication message-digest
 ip ospf message-digest-key 1 md5 {{ std.ospf_md5_key }}
{% endif %}
{% endif %}
{% if intf.vrrp is defined %}
 vrrp {{ intf.vrrp.vrid }}
 vrrp {{ intf.vrrp.vrid }} priority {{ intf.vrrp.priority }}
 vrrp {{ intf.vrrp.vrid }} ip {{ intf.vrrp.vip }}
{% endif %}
!
{% endfor %}
interface lo
 ip address {{ r.loopback }}
!
{% if r.static_routes is defined %}
{% for route in r.static_routes %}
ip route {{ route.prefix }} {{ route.next_hop }}
{% endfor %}
!
{% endif %}
{% if r.prefix_lists is defined %}
{% for name, prefixes in r.prefix_lists.items() %}
{% for prefix in prefixes %}
ip prefix-list {{ name }} seq {{ loop.index * 10 }} permit {{ prefix }}
{% endfor %}
{% endfor %}
!
{% for name, plist in r.route_maps.items() %}
route-map {{ name }} permit 10
 match ip address prefix-list {{ plist }}
!
{% endfor %}
{% endif %}
{% if r.ospf is defined %}
router ospf
 ospf router-id {{ r.ospf.router_id }}
{# Passive by default: every interface except the router-to-router links #}
 passive-interface lo
{% for intf in r.interfaces if not (intf.ospf_p2p | default(false)) %}
 passive-interface {{ intf.name }}
{% if intf.vrrp is defined %}
 passive-interface vrrp4-{{ intf.vrrp.vrid }}
{% endif %}
{% endfor %}
{% for net in r.ospf.networks %}
 network {{ net }} area 0
{% endfor %}
{% if r.ospf.default_originate | default(false) %}
 default-information originate
{% endif %}
!
{% endif %}
{% if r.bgp is defined %}
router bgp {{ r.bgp.asn }}
 bgp router-id {{ r.bgp.router_id }}
{% for n in r.bgp.neighbors %}
{% set ebgp = n.remote_as != r.bgp.asn %}
 neighbor {{ n.ip }} remote-as {{ n.remote_as }}
 neighbor {{ n.ip }} description {{ n.description }}
{% if n.update_source is defined %}
 neighbor {{ n.ip }} update-source {{ n.update_source }}
{% endif %}
{% if std.bgp_password is defined %}
 neighbor {{ n.ip }} password {{ std.bgp_password }}
{% endif %}
{% if ebgp and std.ebgp_bfd | default(false) %}
 neighbor {{ n.ip }} bfd
{% endif %}
{% endfor %}
 !
 address-family ipv4 unicast
{% for net in r.bgp.networks | default([]) %}
  network {{ net }}
{% endfor %}
{% for n in r.bgp.neighbors %}
{% set ebgp = n.remote_as != r.bgp.asn %}
  neighbor {{ n.ip }} activate
{% if n.next_hop_self | default(false) %}
  neighbor {{ n.ip }} next-hop-self
{% endif %}
{% if n.default_originate | default(false) %}
  neighbor {{ n.ip }} default-originate
{% endif %}
{% if n.route_map_in is defined %}
  neighbor {{ n.ip }} route-map {{ n.route_map_in }} in
{% endif %}
{% if n.route_map_out is defined %}
  neighbor {{ n.ip }} route-map {{ n.route_map_out }} out
{% endif %}
{% if ebgp and std.ebgp_max_prefix is defined %}
  neighbor {{ n.ip }} maximum-prefix {{ std.ebgp_max_prefix }}
{% endif %}
{% endfor %}
 exit-address-family
!
{% endif %}
line vty
!
